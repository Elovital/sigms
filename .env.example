# ══════════════════════════════════════════════════════════════════════════════
# SIGMS ELOVITAL — Variáveis de Ambiente
# Copiar para .env e preencher os valores reais.
# O ficheiro .env NÃO deve ser submetido ao git (já está no .gitignore).
# ══════════════════════════════════════════════════════════════════════════════

# ── Base de dados ──────────────────────────────────────────────────────────────
# ⚠ NUNCA usar SQLite com caminho absoluto em produção cloud (dados apagados em cada restart)
#
# Self-hosting (docker-compose — configurado automaticamente, não alterar):
#   DATABASE_URL=postgresql+asyncpg://sigms:SigmsSecure2026!@db:5432/sigms
#
# Supabase (grátis, sem expiração — https://supabase.com):
#   DATABASE_URL=postgresql+asyncpg://postgres:[PASS]@[HOST].supabase.co:5432/postgres
#
# Neon (grátis, serverless — https://neon.tech):
#   DATABASE_URL=postgresql+asyncpg://[USER]:[PASS]@[HOST].neon.tech/[DB]?sslmode=require
#
# Desenvolvimento local (SQLite — caminho relativo, dados mantidos entre restarts):
DATABASE_URL=sqlite+aiosqlite:///./data/sigms.db

# Password do PostgreSQL (para docker-compose — o compose cria o utilizador automaticamente)
POSTGRES_PASSWORD=SigmsSecure2026!

# ── Segurança ─────────────────────────────────────────────────────────────────
# MUDAR OBRIGATORIAMENTE em produção.
# Gerar chaves seguras: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=MUDAR_string_aleatoria_minimo_32_caracteres
ENCRYPTION_KEY=MUDAR_string_aleatoria_minimo_32_caracteres

# ── Tokens de expiração ────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_NAME=SIGMS
APP_VERSION=1.0.0
APP_URL=http://localhost:8000
APP_PORT=8000

# ── Email (opcional — para recuperação de senha) ──────────────────────────────
# Brevo API (recomendado — sem restrições de porta):
BREVO_API_KEY=

# OU SMTP directo:
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cotacao@elovital-ao.com
SMTP_FROM_NAME=ELOVITAL - Mediacao de Seguros
